# Database - use DATABASE_URL in production (Neon/Render), split vars for local dev
# DATABASE_URL=postgresql://user:password@host/dbname
DB_USER=postgres
DB_HOST=localhost
DB_NAME=coolman_workshop
DB_PASSWORD=your_password_here
DB_PORT=5432

# JWT
JWT_SECRET=generate-a-strong-random-string-here

# Server
PORT=5000
NODE_ENV=development

# Client URL(s) — comma-separated list for CORS
CLIENT_URL=http://localhost:5173